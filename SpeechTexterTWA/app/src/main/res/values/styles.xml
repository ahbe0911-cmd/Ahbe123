<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SpeechTexterTwa" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="fontFamily">@font/vazirmatn_regular</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:colorAccent">@color/brand_secondary</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Widget.SpeechTexter.PrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.SpeechTexter.OutlineButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="fontFamily">@font/vazirmatn_regular</item>
    </style>

    <style name="Widget.SpeechTexter.DangerButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_danger_button</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:fontFamily">@font/vazirmatn_regular</item>
        <item name="fontFamily">@font/vazirmatn_regular</item>
    </style>
</resources>
