+package ir.voxfa.keyboard
+
+/**
+ * Conservative post-processing for offline Persian ASR.
+ *
+ * This layer only normalizes orthography/spacing and a few unambiguous spoken
+ * digit sequences. It deliberately avoids semantic rewrites so the user's
+ * meaning is not changed by post-processing.
+ */
+object PersianSpeechPostProcessor {
+    private const val ZWNJ = "\u200C"
+
+    private val singleDigits = mapOf(
+        "صفر" to "۰",
+        "یک" to "۱",
+        "دو" to "۲",
+        "سه" to "۳",
+        "چهار" to "۴",
+        "پنج" to "۵",
+        "شش" to "۶",
+        "هفت" to "۷",
+        "هشت" to "۸",
+        "نه" to "۹"
+    )
+
+    fun process(raw: String): String {
+        if (raw.isBlank()) return ""
+
+        var text = VoiceTextNormalizer.normalize(raw)
+            .replace('\u064A', '\u06CC') // ي -> ی
+            .replace('\u0649', '\u06CC') // ى -> ی
+            .replace('\u0643', '\u06A9') // ك -> ک
+            .replace("ۀ", "هٔ")
+            .replace(Regex("[ \\t]+"), " ")
+            .trim()
+
+        text = normalizeClearHalfSpaces(text)
+        text = normalizeSpokenDigitRuns(text)
+        text = normalizePunctuationSpacing(text)
+        return text.trim()
+    }
+
+    private fun normalizeClearHalfSpaces(input: String): String {
+        var value = input
+
+        // Productive Persian verb prefixes. Require a following Persian word so
+        // isolated words such as "می" are not altered.
+        value = value.replace(
+            Regex("(?<![\\p{L}$ZWNJ])(ن?می)\\s+(?=[\\p{L}])"),
+            "$1$ZWNJ"
+        )
+
+        // Very common plural suffixes. Keep this conservative and only join when
+        // the left side already looks like a word.
+        value = value.replace(
+            Regex("([\\p{L}$ZWNJ]{2,})\\s+(ها|های)(?=\\s|$|[،؟!:.])"),
+            "$1$ZWNJ$2"
+        )
+
+        // Common colloquial forms produced by ASR.
+        value = value
+            .replace(Regex("\\bمی\\s*خوام\\b"), "می${ZWNJ}خوام")
+            .replace(Regex("\\bنمی\\s*خوام\\b"), "نمی${ZWNJ}خوام")
+            .replace(Regex("\\bمی\\s*تونم\\b"), "می${ZWNJ}تونم")
+            .replace(Regex("\\bنمی\\s*تونم\\b"), "نمی${ZWNJ}تونم")
+
+        return value
+    }
+
+    /**
+     * Converts only runs of >= 3 individually spoken digits, e.g.
+     * "صفر نه یک دو" -> "۰۹۱۲". A single word such as "سه" stays textual.
+     * This helps phone/card/OTP dictation without rewriting general numbers.
+     */
+    private fun normalizeSpokenDigitRuns(input: String): String {
+        val words = input.split(Regex("(\\s+)")).toMutableList()
+        if (words.size < 2) return input
+
+        val out = ArrayList<String>(words.size)
+        var i = 0
+        while (i < words.size) {
+            val clean = words[i].trim()
+            if (singleDigits.containsKey(clean)) {
+                var j = i
+                val digits = StringBuilder()
+                while (j < words.size) {
+                    val token = words[j].trim()
+                    val digit = singleDigits[token] ?: break
+                    digits.append(digit)
+                    j++
+                }
+                if (j - i >= 3) {
+                    out += digits.toString()
+                    i = j
+                    continue
+                }
+            }
+            out += words[i]
+            i++
+        }
+        return out.joinToString(" ")
+    }
+
+    private fun normalizePunctuationSpacing(input: String): String = input
+        .replace(Regex("\\s+([،؛؟!:.])"), "$1")
+        .replace(Regex("([،؛؟!:.])(?=[^\\s\\n،؛؟!:.])"), "$1 ")
+        .replace(Regex(" *\\n *"), "\\n")
+        .replace(Regex(" {2,}"), " ")
+}
