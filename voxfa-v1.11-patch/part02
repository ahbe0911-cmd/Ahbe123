ffer(buffer)
+    }
+
+    private fun extractJsonText(json: String, key: String): String = try {
+        JSONObject(json).optString(key).trim()
+    } catch (_: Throwable) {
+        ""
+    }
+
+    private fun computeRmsDbFs(samples: ShortArray, length: Int): Float {
+        if (length <= 0) return -90f
+        var sum = 0.0
+        for (i in 0 until length) {
+            val v = samples[i].toDouble() / 32768.0
+            sum += v * v
+        }
+        val rms = sqrt(sum / length).coerceAtLeast(1e-7)
+        return (20.0 * log10(rms)).toFloat().coerceIn(-90f, 0f)
+    }
+
+    /** Maps physical dBFS to the legacy waveform's expected roughly -2..10 range. */
+    private fun dbFsToUiRms(dbFs: Float): Float {
+        val normalized = ((dbFs + 58f) / 48f).coerceIn(0f, 1f)
+        return -2f + normalized * 12f
+    }
+
+    private fun post(block: () -> Unit) {
+        if (released.get()) return
+        mainHandler.post {
+            if (!released.get()) block()
+        }
+    }
+
+    companion object {
