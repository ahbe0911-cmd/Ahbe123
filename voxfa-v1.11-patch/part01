+                val t0 = SystemClock.elapsedRealtimeNanos()
+                val endpoint = recognizer.acceptWaveForm(chunk.samples, chunk.length)
+                val inferenceMs = (SystemClock.elapsedRealtimeNanos() - t0) / 1_000_000.0
+                inferenceEmaMs = if (inferenceEmaMs == 0.0) inferenceMs else inferenceEmaMs * 0.88 + inferenceMs * 0.12
+                decodedAudioMs += CHUNK_MS
+                inferenceWallMs += inferenceMs.toLong()
