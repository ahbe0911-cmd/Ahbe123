+                // should finalize the current utterance for responsive typing.
+                setEndpointerDelays(8.0f, 1.05f, 45.0f)
+            }
+
+            while (running.get() || queue.isNotEmpty()) {
+                trimBacklog()
+                val chunk = try {
+                    queue.poll(120, java.util.concurrent.TimeUnit.MILLISECONDS)
+                } catch (_: InterruptedException) {
+                    if (!running.get()) null else continue
+                } ?: continue
