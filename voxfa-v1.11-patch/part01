+    /** Drop old PCM only when the decoder is actually behind, never let backlog grow unbounded. */
+    private fun trimBacklog() {
+        while (queue.size > 2) {
+            val head = queue.peek() ?: return
+            val age = SystemClock.elapsedRealtime() - head.capturedAtMs
+            if (age <= MAX_QUEUE_LATENCY_MS) return
+            queue.poll()?.let {
+                recycle(it.samples)
+                droppedChunks++
+            }
+        }
+    }
