+    private fun ensureModelInstalled(): File {
+        val root = File(appContext.noBackupFilesDir, MODEL_INSTALL_DIR)
+        val marker = File(root, ".voxfa-model-version")
+        if (marker.isFile && marker.readText().trim() == MODEL_VERSION && File(root, "am/final.mdl").isFile) {
+            return root
+        }
+
+        root.deleteRecursively()
+        root.mkdirs()
+        copyAssetTree(MODEL_ASSET_DIR, root)
+        check(File(root, "am/final.mdl").isFile) { "Vosk acoustic model missing after asset copy" }
+        marker.writeText(MODEL_VERSION)
+        return root
+    }
