+    private fun createAudioRecord(bufferBytes: Int): AudioRecord? {
+        fun build(source: Int): AudioRecord? = try {
+            AudioRecord(
+                source,
+                SAMPLE_RATE,
+                AudioFormat.CHANNEL_IN_MONO,
+                AudioFormat.ENCODING_PCM_16BIT,
+                bufferBytes
+            )
+        } catch (_: Throwable) {
+            null
+        }
+
+        val speech = build(MediaRecorder.AudioSource.VOICE_RECOGNITION)
+        if (speech?.state == AudioRecord.STATE_INITIALIZED) return speech
+        runCatching { speech?.release() }
+        return build(MediaRecorder.AudioSource.MIC)
+    }
