+                } else {
+                    consecutiveVoice = 0
+                    consecutiveSilence++
+                    if (!speechActive) {
+                        noiseFloorDb = noiseFloorDb * 0.97f + chunk.rmsDbFs.coerceAtMost(-35f) * 0.03f
+                    }
+                    if (speechActive && consecutiveSilence >= END_SILENCE_CHUNKS) {
+                        speechActive = false
+                        post { listener.onSpeechEnded() }
+                    }
+                }
