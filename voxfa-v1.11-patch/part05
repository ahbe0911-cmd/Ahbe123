+#!/usr/bin/env bash
+set -euo pipefail
+
+MODEL_NAME="vosk-model-small-fa-0.42"
+MODEL_ZIP="${MODEL_NAME}.zip"
+MODEL_SHA256="977cb5faa538f3a835ccfd35f5f6d8284b5c450b89c700b9bd4736b66536ad46"
+PRIMARY_URL="https://alphacephei.com/vosk/models/${MODEL_ZIP}"
+ASSET_DIR="${1:-app/src/main/assets/model-fa}"
+TMP_DIR="$(mktemp -d)"
+trap 'rm -rf "$TMP_DIR"' EXIT
+
+mkdir -p "$(dirname "$ASSET_DIR")"
+rm -rf "$ASSET_DIR"
+
+echo "Downloading verified Persian offline ASR model: $MODEL_NAME"
+curl -fL --retry 4 --retry-delay 3 --connect-timeout 20 \
+  "$PRIMARY_URL" -o "$TMP_DIR/$MODEL_ZIP"
+echo "$MODEL_SHA256  $TMP_DIR/$MODEL_ZIP" | sha256sum --check --strict
+unzip -q "$TMP_DIR/$MODEL_ZIP" -d "$TMP_DIR/unpacked"
+test -f "$TMP_DIR/unpacked/$MODEL_NAME/am/final.mdl"
+mv "$TMP_DIR/unpacked/$MODEL_NAME" "$ASSET_DIR"
+echo "Model ready at $ASSET_DIR"
