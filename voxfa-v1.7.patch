+    /**
+     * Some recognizer implementations can stay in a listening state without ever
+     * emitting partial text. Keep the mic continuous, but recover only when the
+     * engine is demonstrably stuck or speech has ended without text.
+     */
+    private val speechWatchdogRunnable = object : Runnable {
+        override fun run() {
+            if (!wantListening) return
+            val now = SystemClock.elapsedRealtime()
+            if (actuallyListening) {
+                val waitingForReady = recognizerReadyAt == 0L && recognitionStartedAt > 0L &&
+                    now - recognitionStartedAt > 3_400L
+                if (waitingForReady) {
+                    hardRecoverRecognizer(if (isPersian()) "بازیابی میکروفون…" else "Recovering microphone…")
+                    return
+                }
+
+                val voiceStart = when {
+                    speechBeganAt > 0L -> speechBeganAt
+                    firstVoiceActivityAt > 0L -> firstVoiceActivityAt
+                    else -> 0L
+                }
+                if (voiceStart > 0L && !hasSpeechTextThisSession && !finalizeRequestedByWatchdog) {
+                    val speechAge = now - voiceStart
+                    val quietFor = if (lastVoiceActivityAt > 0L) now - lastVoiceActivityAt else Long.MAX_VALUE
+                    // Normal case: the user has paused after speaking but the service
+                    // produced no partial result. Ask it to finalize instead of hanging.
+                    if ((speechAge > 1_700L && quietFor > 520L) || speechAge > 7_000L) {
+                        finalizeRequestedByWatchdog = true
+                        setVoiceUi(true, if (isPersian()) "در حال تبدیل صدا…" else "Converting speech…")
+                        runCatching { speechRecognizer?.stopListening() }
+                            .onFailure { hardRecoverRecognizer(if (isPersian()) "بازیابی تشخیص صوت…" else "Recovering speech…") }
+                    }
+                }
+            }
+            if (wantListening) mainHandler.postDelayed(this, 320L)
+        }
+    }
+
+    private fun ensureSpeechWatchdog() {
+        mainHandler.removeCallbacks(speechWatchdogRunnable)
+        if (wantListening) mainHandler.postDelayed(speechWatchdogRunnable, 320L)
+    }
+
+    private fun hardRecoverRecognizer(message: String) {
+        mainHandler.removeCallbacks(speechWatchdogRunnable)
+        runCatching { speechRecognizer?.cancel() }
+        actuallyListening = false
+        speechComposingActive = false
+        setVoiceUi(true, message)
+        prepareRecognizer()
+        if (wantListening) scheduleRestart(180L)
     }
 
