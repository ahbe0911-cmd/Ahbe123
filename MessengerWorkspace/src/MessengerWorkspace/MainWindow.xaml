<Window x:Class="MessengerWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MessengerWorkspace.Controls"
        Title="Messenger Workspace Persian Edition"
        Icon="pack://application:,,,/Assets/App.ico"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource PersianFont}"
        MinWidth="1024" MinHeight="650"
        Background="#FF0F5EA8"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.12" GradientOrigin="0.15,0.08" RadiusX="1.0" RadiusY="1.0">
                <GradientStop Color="#FFB9E6FF" Offset="0"/>
                <GradientStop Color="#FF5DA7F2" Offset="0.36"/>
                <GradientStop Color="#FF2966CE" Offset="0.72"/>
                <GradientStop Color="#FF17498E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,12,18,0" CornerRadius="18" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" FlowDirection="LeftToRight" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="تنظیمات" Style="{StaticResource HeaderButtonStyle}" Click="SettingsButton_Click"/>
                    <Button Content="↻" ToolTip="بارگذاری مجدد" Style="{StaticResource HeaderButtonStyle}" Click="Refresh_Click"/>
                    <Button Content="→" ToolTip="بعدی" Style="{StaticResource HeaderButtonStyle}" Click="Forward_Click"/>
                    <Button Content="←" ToolTip="قبلی" Style="{StaticResource HeaderButtonStyle}" Click="Back_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="💬" FontSize="23" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Messenger Workspace" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="نسخه فارسی · شاد و روبیکا" Foreground="#CCFFFFFF" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,12,18,8" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RubikaColumn" Width="*"/>
                <ColumnDefinition x:Name="GapColumn" Width="12"/>
                <ColumnDefinition x:Name="ShadColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="RubikaPanel" Grid.Column="0" CornerRadius="22" Background="#DDFBFDFF" BorderBrush="#55FFFFFF" BorderThickness="1" Effect="{DynamicResource PanelShadow}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5FFFFFF" CornerRadius="22,22,0,0">
                        <DockPanel Margin="14,0" FlowDirection="RightToLeft">
                            <TextBlock Text="Rubika Web" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#263544"/>
                            <TextBlock Text="https://m.rubika.ir" FontSize="11" VerticalAlignment="Center" Foreground="#66798B" Margin="12,0"/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="RubikaHost" Grid.Row="1" Background="#FFFFFFFF" AllowDrop="True"/>
                </Grid>
            </Border>

            <Border x:Name="ShadPanel" Grid.Column="2" CornerRadius="22" Background="#DDFBFDFF" BorderBrush="#55FFFFFF" BorderThickness="1" Effect="{DynamicResource PanelShadow}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5FFFFFF" CornerRadius="22,22,0,0">
                        <DockPanel Margin="14,0" FlowDirection="RightToLeft">
                            <TextBlock Text="Shad Web" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#263544"/>
                            <TextBlock Text="https://my.shad.ir" FontSize="11" VerticalAlignment="Center" Foreground="#66798B" Margin="12,0"/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="ShadHost" Grid.Row="1" Background="#FFFFFFFF" AllowDrop="True"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="22,0" Foreground="#DFFFFFFF" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="330" CornerRadius="18" Background="#F9FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="14" FlowDirection="RightToLeft">
                <StackPanel>
                    <TextBlock Text="تنظیمات" FontWeight="Bold" FontSize="17" Foreground="#1D2A36" Margin="0,0,0,10"/>
                    <TextBlock Text="حالت نمایش" FontSize="12" Foreground="#5C6975"/>
                    <ComboBox x:Name="ModeCombo" Margin="0,5,0,12" SelectionChanged="ModeCombo_SelectionChanged">
                        <ComboBoxItem Content="دو پنجره: روبیکا | شاد" Tag="Dual"/>
                        <ComboBoxItem Content="فقط روبیکا" Tag="RubikaOnly"/>
                        <ComboBoxItem Content="فقط شاد" Tag="ShadOnly"/>
                    </ComboBox>
                    <CheckBox x:Name="AutoStartCheck" Content="اجرای خودکار با روشن شدن ویندوز" Margin="0,4,0,12" Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                    <TextBlock Text="Zoom" FontSize="12" Foreground="#5C6975"/>
                    <Slider x:Name="ZoomSlider" Minimum="80" Maximum="130" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock x:Name="ZoomText" FontSize="11" Foreground="#5C6975" Margin="0,0,0,12"/>
                    <Button Content="پاک کردن Cache" Style="{StaticResource HeaderButtonStyle}" Foreground="#263544" Click="ClearCache_Click"/>
                    <Button Content="بررسی بروزرسانی" Style="{StaticResource HeaderButtonStyle}" Foreground="#263544" Margin="3,8,3,0" Click="CheckUpdate_Click"/>
                </StackPanel>
            </Border>
        </Popup>
        <local:FindOverlay x:Name="FindBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"/>
    </Grid>
    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="24" ShadowDepth="5" Opacity="0.22" Color="#00244A"/>
    </Window.Resources>
</Window>
