<Window x:Class="WebHubWin81.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وب‌اپلیکیشن‌ها"
        Width="1160" Height="760"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F7FB">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="20" ShadowDepth="5" Opacity="0.12" Color="#182033"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#43506A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#5E43E8"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="HomeView">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1" Padding="32,20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="وب‌اپلیکیشن‌ها" FontSize="27" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="دسترسی مستقیم به سرویس‌های محبوب در یک برنامه ویندوز" Margin="0,7,0,0" FontSize="13" Foreground="#758096"/></StackPanel>
                    <Border Grid.Column="1" Width="50" Height="50" CornerRadius="16" Background="#F1EDFF" VerticalAlignment="Center"><TextBlock Text="⌂" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5E43E8" FontSize="25" FontWeight="Bold"/></Border>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="32,24,32,20" CornerRadius="26" Padding="26,22" Effect="{StaticResource SoftShadow}">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6950F2" Offset="0"/><GradientStop Color="#4C7AF3" Offset="1"/></LinearGradientBrush></Border.Background>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="همه سرویس‌ها، داخل همین برنامه" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="با انتخاب هر سرویس، وب واقعی آن در مرورگر داخلی برنامه باز می‌شود." Margin="0,9,0,0" Foreground="#F0F3FF" FontSize="13"/></StackPanel>
                    <Border Grid.Column="1" Margin="24,0,0,0" Padding="18,10" CornerRadius="20" Background="#28FFFFFF"><TextBlock Text="Windows 8.1 • x64" Foreground="White" FontSize="12" VerticalAlignment="Center"/></Border>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="32,0,32,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" CornerRadius="24" Background="#FFFFFF" BorderBrush="#DDF2E5" BorderThickness="1" Effect="{StaticResource SoftShadow}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="وب شاد" FontSize="22" FontWeight="Bold" Foreground="#159447"/><TextBlock Text="شبکه آموزشی دانش‌آموزی" Margin="0,8,0,0" FontSize="13" Foreground="#697489"/><TextBlock Text="کلاس‌ها، پیام‌ها و ارتباط آنلاین" Margin="0,4,0,16" FontSize="12" Foreground="#8B94A5"/><Button Style="{StaticResource ServiceButton}" Background="#16A34A" Content="ورود به وب شاد" Tag="https://web.shad.ir/" Click="OpenService_Click"/></StackPanel>
                        <Border Grid.Column="1" Width="84" Height="84" CornerRadius="24" Background="#16A34A" VerticalAlignment="Center"><TextBlock Text="ش" Foreground="White" FontWeight="Bold" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" CornerRadius="24" Background="#FFFFFF" BorderBrush="#E7DFFF" BorderThickness="1" Effect="{StaticResource SoftShadow}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="وب روبیکا" FontSize="22" FontWeight="Bold" Foreground="#6840DE"/><TextBlock Text="پیام‌رسان و سوپراپ ایرانی" Margin="0,8,0,0" FontSize="13" Foreground="#697489"/><TextBlock Text="گفتگوها و سرویس‌های آنلاین" Margin="0,4,0,16" FontSize="12" Foreground="#8B94A5"/><Button Style="{StaticResource ServiceButton}" Background="#6D3BEA" Content="ورود به وب روبیکا" Tag="https://web.rubika.ir/" Click="OpenService_Click"/></StackPanel>
                        <Border Grid.Column="1" Width="84" Height="84" CornerRadius="24" Background="#6D3BEA" VerticalAlignment="Center"><TextBlock Text="ر" Foreground="White" FontWeight="Bold" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" CornerRadius="24" Background="#FFFFFF" BorderBrush="#FFE5CA" BorderThickness="1" Effect="{StaticResource SoftShadow}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="وب ایتا" FontSize="22" FontWeight="Bold" Foreground="#E36D00"/><TextBlock Text="پیام‌رسان اجتماعی ایرانی" Margin="0,8,0,0" FontSize="13" Foreground="#697489"/><TextBlock Text="پیام‌ها، گروه‌ها و کانال‌ها" Margin="0,4,0,16" FontSize="12" Foreground="#8B94A5"/><Button Style="{StaticResource ServiceButton}" Background="#F47700" Content="ورود به وب ایتا" Tag="https://web.eitaa.com/" Click="OpenService_Click"/></StackPanel>
                        <Border Grid.Column="1" Width="84" Height="84" CornerRadius="24" Background="#F47700" VerticalAlignment="Center"><TextBlock Text="ا" Foreground="White" FontWeight="Bold" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" CornerRadius="24" Background="#FFFFFF" BorderBrush="#D7EEFC" BorderThickness="1" Effect="{StaticResource SoftShadow}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="وب تلگرام" FontSize="22" FontWeight="Bold" Foreground="#168CC7"/><TextBlock Text="نسخه وب تلگرام" Margin="0,8,0,0" FontSize="13" Foreground="#697489"/><TextBlock Text="گفتگو، کانال، گروه و مخاطبین" Margin="0,4,0,16" FontSize="12" Foreground="#8B94A5"/><Button Style="{StaticResource ServiceButton}" Background="#179CDE" Content="ورود به وب تلگرام" Tag="https://web.telegram.org/" Click="OpenService_Click"/></StackPanel>
                        <Border Grid.Column="1" Width="84" Height="84" CornerRadius="24" Background="#179CDE" VerticalAlignment="Center"><TextBlock Text="✈" Foreground="White" FontWeight="Bold" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Margin="32,18,32,20" CornerRadius="18" Background="#E9EEF6" Padding="16,10"><TextBlock Text="ورودهای شما در پوشه محلی برنامه نگهداری می‌شود؛ با بازگشت به خانه، نشست سرویس‌ها حفظ می‌شود." Foreground="#697489" FontSize="11" TextAlignment="Center"/></Border>
        </Grid>

        <Grid x:Name="BrowserView" Visibility="Collapsed" Background="#EEF2F7">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1" Padding="16,11">
                <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="⌂" ToolTip="خانه" Click="Home_Click"/>
                    <Button Grid.Column="1" x:Name="BackButton" Style="{StaticResource IconButton}" Content="←" ToolTip="بازگشت" Click="Back_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="↻" ToolTip="بارگذاری مجدد" Click="Reload_Click"/>
                    <Border Grid.Column="3" Margin="10,0" CornerRadius="13" Background="#F3F6FA" BorderBrush="#E5EAF1" BorderThickness="1" Padding="14,0"><TextBlock x:Name="AddressText" FlowDirection="LeftToRight" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#657087" FontSize="12"/></Border>
                    <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock x:Name="ServiceTitle" FontSize="15" FontWeight="Bold" Foreground="#172033" HorizontalAlignment="Right"/><TextBlock x:Name="StatusText" Text="مرورگر داخلی" FontSize="10" Foreground="#8A94A6" HorizontalAlignment="Right"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="BrowserHost" Background="White">
                <Border x:Name="LoadingOverlay" Background="#F4F7FB" Visibility="Collapsed" Panel.ZIndex="4"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="74" Height="74" CornerRadius="24" Background="#5E43E8"><TextBlock Text="W" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="در حال باز کردن سرویس..." Margin="0,18,0,0" Foreground="#273249" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="اولین اجرا ممکن است چند ثانیه زمان ببرد." Margin="0,7,0,0" Foreground="#7A8497" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
